{
  "name": "paper-city-popup",
  "private": true,
  "type": "module",
  "description": "Pop-up books in the browser. The site has no build step; package.json carries the test tools and the mini-tool build.",
  "scripts": {
    "test": "node tests/run.mjs",
    "test:update": "node tests/run.mjs --update",
    "structure": "node tools/structure-report.mjs",
    "build:minitool": "node tools/build-minitool.mjs",
    "share-grid": "node tools/render-share-grid.mjs"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "playwright": "1.56.1"
  }
}
